{
  "name": "smartai-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "node scripts/prepare-hooks.mjs",
    "cz": "czg"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@chenglou/pretext": "^1.0.0",
    "antd": "^6.7.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.1.0",
    "markmap-lib": "^0.18.13",
    "markmap-view": "^0.18.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/preset-attributify": "^66.13.0",
    "@unocss/transformer-attributify-jsx": "^66.13.0",
    "@vitejs/plugin-react": "^6.3.0",
    "czg": "^1.14.0",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "lint-staged": "^17.6.1",
    "typescript": "~7.0.2",
    "unocss": "^66.13.0",
    "vite": "^8.3.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,less,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
