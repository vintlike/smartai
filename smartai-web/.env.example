# 复制为 .env.local 后按需修改，带 VITE_ 前缀的变量会注入到前端代码

# 请求根地址，留空则使用 dev proxy 的 /api 前缀（生产环境可指向完整域名）
VITE_API_BASE_URL=

# dev server 监听地址与端口
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=3344

# dev proxy 目标，/api 请求会转发到这里
VITE_API_TARGET=http://localhost:8080

# 是否启用 dev mock 接口，默认开启；接真后端时改为 false
VITE_USE_MOCK=true

# 混合联调：按路径前缀跳过 mock，转发到真实后端（逗号分隔，VITE_USE_MOCK 为 true 时生效）
# 例如 /api/auth,/api/sys 表示登录与系统管理接口走 smartai-server，其余继续使用 mock
VITE_MOCK_EXCLUDE=

# 菜单数据源：留空使用 src/config/menu.config.tsx 的静态菜单；
# 设为 mock 则从 dev mock 的 /api/sys/menu 获取；设为其他值视为真实菜单接口地址
VITE_MENU_API=
