<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartai.mapper.AigcDocsMapper">

    <resultMap id="docsMap" type="com.smartai.entity.AigcDocs">
        <id column="id" property="id"/>
        <result column="knowledge_id" property="knowledgeId"/>
        <result column="name" property="name"/>
        <result column="source_type" property="sourceType"/>
        <result column="url" property="url"/>
        <result column="file_ext" property="fileExt"/>
        <result column="content" property="content"/>
        <result column="file_size" property="fileSize"/>
        <result column="slice_count" property="sliceCount"/>
        <result column="slice_status" property="sliceStatus"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="columns">
        id, knowledge_id, name, source_type, url, file_ext, content, file_size, slice_count, slice_status, create_time
    </sql>

    <select id="selectById" resultMap="docsMap">
        SELECT <include refid="columns"/> FROM aigc_docs WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="docsMap">
        SELECT <include refid="columns"/> FROM aigc_docs
        <where>
            <if test="knowledgeId != null and knowledgeId != ''">
                AND knowledge_id = #{knowledgeId}
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="sourceType != null and sourceType != ''">
                AND source_type = #{sourceType}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectByKnowledgeId" resultMap="docsMap">
        SELECT <include refid="columns"/> FROM aigc_docs
        WHERE knowledge_id = #{knowledgeId}
        ORDER BY create_time ASC
    </select>

    <insert id="insert">
        INSERT INTO aigc_docs (<include refid="columns"/>)
        VALUES (#{id}, #{knowledgeId}, #{name}, #{sourceType}, #{url}, #{fileExt}, #{content}, #{fileSize},
                #{sliceCount}, #{sliceStatus}, #{createTime})
    </insert>

    <update id="updateById">
        UPDATE aigc_docs
        <set>
            id = #{id},
            <if test="knowledgeId != null">knowledge_id = #{knowledgeId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="url != null">url = #{url},</if>
            <if test="fileExt != null">file_ext = #{fileExt},</if>
            <if test="content != null">content = #{content},</if>
            <if test="fileSize != null">file_size = #{fileSize},</if>
            <if test="sliceCount != null">slice_count = #{sliceCount},</if>
            <if test="sliceStatus != null">slice_status = #{sliceStatus},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM aigc_docs WHERE id = #{id}
    </delete>

    <delete id="deleteByKnowledgeId">
        DELETE FROM aigc_docs WHERE knowledge_id = #{knowledgeId}
    </delete>
</mapper>
