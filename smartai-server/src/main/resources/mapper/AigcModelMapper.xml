<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartai.mapper.AigcModelMapper">

    <resultMap id="modelMap" type="com.smartai.entity.AigcModel">
        <id column="id" property="id"/>
        <result column="type" property="type"/>
        <result column="model" property="model"/>
        <result column="provider" property="provider"/>
        <result column="name" property="name"/>
        <result column="max_output_tokens" property="maxOutputTokens"/>
        <result column="temperature" property="temperature"/>
        <result column="top_p" property="topP"/>
        <result column="api_key" property="apiKey"/>
        <result column="base_url" property="baseUrl"/>
        <result column="secret_key" property="secretKey"/>
        <result column="endpoint" property="endpoint"/>
        <result column="azure_deployment_name" property="azureDeploymentName"/>
        <result column="gemini_project" property="geminiProject"/>
        <result column="gemini_location" property="geminiLocation"/>
        <result column="image_size" property="imageSize"/>
        <result column="image_quality" property="imageQuality"/>
        <result column="image_style" property="imageStyle"/>
        <result column="dimension" property="dimension"/>
        <result column="status" property="status"/>
        <result column="show_status" property="showStatus"/>
    </resultMap>

    <sql id="columns">
        id, type, model, provider, name, max_output_tokens, temperature, top_p, api_key, base_url, secret_key,
        endpoint, azure_deployment_name, gemini_project, gemini_location, image_size, image_quality, image_style,
        dimension, status, show_status
    </sql>

    <select id="selectById" resultMap="modelMap">
        SELECT <include refid="columns"/> FROM aigc_model WHERE id = #{id}
    </select>

    <select id="selectByModel" resultMap="modelMap">
        SELECT <include refid="columns"/> FROM aigc_model WHERE model = #{model} LIMIT 1
    </select>

    <select id="selectList" resultMap="modelMap">
        SELECT <include refid="columns"/> FROM aigc_model
        <where>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
            <if test="provider != null and provider != ''">
                AND provider = #{provider}
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="showStatus != null">
                AND show_status = #{showStatus}
            </if>
        </where>
        ORDER BY model
    </select>

    <insert id="insert">
        INSERT INTO aigc_model (<include refid="columns"/>)
        VALUES (#{id}, #{type}, #{model}, #{provider}, #{name}, #{maxOutputTokens}, #{temperature}, #{topP},
                #{apiKey}, #{baseUrl}, #{secretKey}, #{endpoint}, #{azureDeploymentName}, #{geminiProject},
                #{geminiLocation}, #{imageSize}, #{imageQuality}, #{imageStyle}, #{dimension}, #{status}, #{showStatus})
    </insert>

    <update id="updateById">
        UPDATE aigc_model
        <set>
            id = #{id},
            <if test="type != null">type = #{type},</if>
            <if test="model != null">model = #{model},</if>
            <if test="provider != null">provider = #{provider},</if>
            <if test="name != null">name = #{name},</if>
            <if test="maxOutputTokens != null">max_output_tokens = #{maxOutputTokens},</if>
            <if test="temperature != null">temperature = #{temperature},</if>
            <if test="topP != null">top_p = #{topP},</if>
            <if test="apiKey != null">api_key = #{apiKey},</if>
            <if test="baseUrl != null">base_url = #{baseUrl},</if>
            <if test="secretKey != null">secret_key = #{secretKey},</if>
            <if test="endpoint != null">endpoint = #{endpoint},</if>
            <if test="azureDeploymentName != null">azure_deployment_name = #{azureDeploymentName},</if>
            <if test="geminiProject != null">gemini_project = #{geminiProject},</if>
            <if test="geminiLocation != null">gemini_location = #{geminiLocation},</if>
            <if test="imageSize != null">image_size = #{imageSize},</if>
            <if test="imageQuality != null">image_quality = #{imageQuality},</if>
            <if test="imageStyle != null">image_style = #{imageStyle},</if>
            <if test="dimension != null">dimension = #{dimension},</if>
            <if test="status != null">status = #{status},</if>
            <if test="showStatus != null">show_status = #{showStatus},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM aigc_model WHERE id = #{id}
    </delete>
</mapper>
