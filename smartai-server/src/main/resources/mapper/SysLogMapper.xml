<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartai.mapper.SysLogMapper">

    <resultMap id="logMap" type="com.smartai.entity.SysLog">
        <id column="id" property="id"/>
        <result column="result_status" property="resultStatus"/>
        <result column="username" property="username"/>
        <result column="operation" property="operation"/>
        <result column="url" property="url"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="method" property="method"/>
        <result column="request_params" property="requestParams"/>
        <result column="ip" property="ip"/>
        <result column="user_agent" property="userAgent"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="columns">
        id, result_status, username, operation, url, duration_ms, method, request_params, ip, user_agent, create_time
    </sql>

    <select id="selectById" resultMap="logMap">
        SELECT <include refid="columns"/> FROM sys_log WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="logMap">
        SELECT <include refid="columns"/> FROM sys_log
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="operation != null and operation != ''">
                AND operation LIKE CONCAT('%', #{operation}, '%')
            </if>
            <if test="resultStatus != null">
                AND result_status = #{resultStatus}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insert">
        INSERT INTO sys_log (<include refid="columns"/>)
        VALUES (#{id}, #{resultStatus}, #{username}, #{operation}, #{url}, #{durationMs}, #{method},
                #{requestParams}, #{ip}, #{userAgent}, #{createTime})
    </insert>

    <delete id="deleteById">
        DELETE FROM sys_log WHERE id = #{id}
    </delete>

    <delete id="deleteAll">
        DELETE FROM sys_log
    </delete>
</mapper>
