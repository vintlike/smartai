<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartai.mapper.AigcEmbedStoreMapper">

    <resultMap id="storeMap" type="com.smartai.entity.AigcEmbedStore">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="provider" property="provider"/>
        <result column="host" property="host"/>
        <result column="port" property="port"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="database_name" property="databaseName"/>
        <result column="table_name" property="tableName"/>
        <result column="dimension" property="dimension"/>
    </resultMap>

    <sql id="columns">
        id, name, provider, host, port, username, password, database_name, table_name, dimension
    </sql>

    <select id="selectById" resultMap="storeMap">
        SELECT <include refid="columns"/> FROM aigc_embed_store WHERE id = #{id}
    </select>

    <select id="selectByName" resultMap="storeMap">
        SELECT <include refid="columns"/> FROM aigc_embed_store WHERE name = #{name}
    </select>

    <select id="selectList" resultMap="storeMap">
        SELECT <include refid="columns"/> FROM aigc_embed_store
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="provider != null and provider != ''">
                AND provider = #{provider}
            </if>
        </where>
        ORDER BY name
    </select>

    <insert id="insert">
        INSERT INTO aigc_embed_store (<include refid="columns"/>)
        VALUES (#{id}, #{name}, #{provider}, #{host}, #{port}, #{username}, #{password}, #{databaseName},
                #{tableName}, #{dimension})
    </insert>

    <update id="updateById">
        UPDATE aigc_embed_store
        <set>
            id = #{id},
            <if test="name != null">name = #{name},</if>
            <if test="provider != null">provider = #{provider},</if>
            <if test="host != null">host = #{host},</if>
            <if test="port != null">port = #{port},</if>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="databaseName != null">database_name = #{databaseName},</if>
            <if test="tableName != null">table_name = #{tableName},</if>
            <if test="dimension != null">dimension = #{dimension},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM aigc_embed_store WHERE id = #{id}
    </delete>
</mapper>
