<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartai.mapper.SysUserMapper">

    <resultMap id="userMap" type="com.smartai.entity.SysUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
        <result column="gender" property="gender"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="dept_id" property="deptId"/>
        <result column="avatar" property="avatar"/>
        <result column="is_enabled" property="isEnabled"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="columns">
        id, username, password, real_name, gender, phone, email, dept_id, avatar, is_enabled, create_time
    </sql>

    <select id="selectById" resultMap="userMap">
        SELECT <include refid="columns"/> FROM sys_user WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultMap="userMap">
        SELECT <include refid="columns"/> FROM sys_user WHERE username = #{username}
    </select>

    <select id="selectList" resultMap="userMap">
        SELECT <include refid="columns"/> FROM sys_user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="realName != null and realName != ''">
                AND real_name LIKE CONCAT('%', #{realName}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
            <if test="deptId != null and deptId != ''">
                AND dept_id = #{deptId}
            </if>
            <if test="isEnabled != null">
                AND is_enabled = #{isEnabled}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insert">
        INSERT INTO sys_user (<include refid="columns"/>)
        VALUES (#{id}, #{username}, #{password}, #{realName}, #{gender}, #{phone}, #{email},
                #{deptId}, #{avatar}, #{isEnabled}, #{createTime})
    </insert>

    <update id="updateById">
        UPDATE sys_user
        <set>
            id = #{id},
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="isEnabled != null">is_enabled = #{isEnabled},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE sys_user SET password = #{password} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>
</mapper>
