<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartai.mapper.AigcAppApiMapper">

    <resultMap id="appApiMap" type="com.smartai.entity.AigcAppApi">
        <id column="id" property="id"/>
        <result column="app_id" property="appId"/>
        <result column="channel" property="channel"/>
        <result column="api_key" property="apiKey"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="columns">id, app_id, channel, api_key, create_time</sql>

    <select id="selectById" resultMap="appApiMap">
        SELECT <include refid="columns"/> FROM aigc_app_api WHERE id = #{id}
    </select>

    <select id="selectByAppId" resultMap="appApiMap">
        SELECT <include refid="columns"/> FROM aigc_app_api
        WHERE app_id = #{appId}
        ORDER BY create_time DESC
    </select>

    <insert id="insert">
        INSERT INTO aigc_app_api (<include refid="columns"/>)
        VALUES (#{id}, #{appId}, #{channel}, #{apiKey}, #{createTime})
    </insert>

    <delete id="deleteById">
        DELETE FROM aigc_app_api WHERE id = #{id}
    </delete>

    <delete id="deleteByAppId">
        DELETE FROM aigc_app_api WHERE app_id = #{appId}
    </delete>
</mapper>
