<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartai.mapper.AnnotationCategoryMapper">

    <resultMap id="categoryMap" type="com.smartai.entity.AnnotationCategory">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="category_key" property="categoryKey"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="columns">id, parent_id, category_key, name, description, sort_order, create_time</sql>

    <select id="selectById" resultMap="categoryMap">
        SELECT <include refid="columns"/> FROM annotation_category WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="categoryMap">
        SELECT <include refid="columns"/> FROM annotation_category
        <where>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%')
                     OR category_key LIKE CONCAT('%', #{keyword}, '%')
                     OR description LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY sort_order, id
    </select>

    <select id="countByParentId" resultType="int">
        SELECT COUNT(*) FROM annotation_category WHERE parent_id = #{parentId}
    </select>

    <insert id="insert">
        INSERT INTO annotation_category (<include refid="columns"/>)
        VALUES (#{id}, #{parentId}, #{categoryKey}, #{name}, #{description}, #{sortOrder}, #{createTime})
    </insert>

    <update id="updateById">
        UPDATE annotation_category
        <set>
            id = #{id},
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="categoryKey != null">category_key = #{categoryKey},</if>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateSort">
        UPDATE annotation_category SET sort_order = #{sortOrder} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM annotation_category WHERE id = #{id}
    </delete>
</mapper>
