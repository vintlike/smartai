<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartai.mapper.AigcAppMapper">

    <resultMap id="appMap" type="com.smartai.entity.AigcApp">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="username" property="username"/>
        <result column="model_id" property="modelId"/>
        <result column="knowledge_ids" property="knowledgeIds"/>
        <result column="cover" property="cover"/>
        <result column="name" property="name"/>
        <result column="prompt" property="prompt"/>
        <result column="description" property="description"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="selectWithUser">
        SELECT a.id, a.user_id, u.username, a.model_id, a.knowledge_ids, a.cover, a.name, a.prompt,
               a.description, a.update_time, a.create_time
        FROM aigc_app a
        LEFT JOIN sys_user u ON a.user_id = u.id
    </sql>

    <select id="selectById" resultMap="appMap">
        <include refid="selectWithUser"/>
        WHERE a.id = #{id}
    </select>

    <select id="selectList" resultMap="appMap">
        <include refid="selectWithUser"/>
        <where>
            <if test="name != null and name != ''">
                AND a.name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
        ORDER BY a.create_time DESC
    </select>

    <insert id="insert">
        INSERT INTO aigc_app (id, user_id, model_id, knowledge_ids, cover, name, prompt, description,
                              update_time, create_time)
        VALUES (#{id}, #{userId}, #{modelId}, #{knowledgeIds}, #{cover}, #{name}, #{prompt}, #{description},
                #{updateTime}, #{createTime})
    </insert>

    <update id="updateById">
        UPDATE aigc_app
        <set>
            id = #{id},
            <if test="userId != null">user_id = #{userId},</if>
            <if test="modelId != null">model_id = #{modelId},</if>
            <if test="knowledgeIds != null">knowledge_ids = #{knowledgeIds},</if>
            <if test="cover != null">cover = #{cover},</if>
            <if test="name != null">name = #{name},</if>
            <if test="prompt != null">prompt = #{prompt},</if>
            <if test="description != null">description = #{description},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM aigc_app WHERE id = #{id}
    </delete>
</mapper>
